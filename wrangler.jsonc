{
  "name": "noa",
  "main": "src/worker.js",
  "compatibility_date": "2026-09-01",
  "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": true },
  "d1_databases": [{ "binding": "DB", "database_name": "noa", "database_id": "33c1f48d-0213-4794-b09b-37aa078125bb" }],
  "ai": { "binding": "AI" },
  "workers_dev": true,
  "preview_urls": false,
  "vars": {
    // the real domain(s) later: only the website is served there, the Studio stays on workers.dev
    "PUBLIC_HOSTS": "",
    "PUBLISHERS": "Lea",
    "ACCESS_TEAM_DOMAIN": "studiohuit.cloudflareaccess.com",
    // AUD of the Access app that protects /studio and /api on this Worker
    "ACCESS_AUD": "886af93ffb705c38e86fb1b60fff94c94e95f7df73fa220b3ff5723732669dd6",
    "USERS": "{\"lea@huit.studio\":\"Lea\"}"
  },
  "observability": { "enabled": true }
}
